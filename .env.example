# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Daraz API Configuration
DARAZ_APP_KEY=your_daraz_app_key
DARAZ_APP_SECRET=your_daraz_app_secret

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Customize rate limits (requests per second)
# DARAZ_RATE_LIMIT_ORDERS=20
# DARAZ_RATE_LIMIT_PRODUCTS=10
# DARAZ_RATE_LIMIT_TOKEN_REFRESH=2
# DARAZ_RATE_LIMIT_DEFAULT=5

# Optional: Sync configuration
# SYNC_LOCK_TIMEOUT_MINUTES=5
# SYNC_LOCK_EXTENSION_MINUTES=2
# SCAN_CACHE_TTL_SECONDS=30
# SCAN_DEBOUNCE_MS=500